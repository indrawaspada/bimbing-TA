# ADMIN / TEST ONLY — copy to .secrets/admin.env (git-ignored; never read by Vite, never bundled).
# Used by scripts/hosted-migrate.mjs and tests/hosted/*. Never paste these values into chat or logs.
# Database connection string: Supabase Dashboard -> Connect -> Session pooler (IPv4) or Direct connection.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Dashboard -> Project Settings -> API Keys -> service_role (secret). Used ONLY for synthetic persona setup/teardown.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
